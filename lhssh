#!/usr/bin/bash
# lhssh v2.0 - Local Host SSH Scanner and Connection Manager
#
# Description:
#   A modern, dependency-free bash utility for scanning and managing SSH connections
#   to hosts on the local network. Supports parallel scanning, IPv6 link-local
#   discovery, colored output, temporary host blocking via nft, and flexible
#   configuration.
#
# Dependencies:
#   - ssh (OpenSSH client)
#   - ssh-keyscan OR nc (netcat) for network scanning
#   - timeout (coreutils)
#   - ping6 or ping, and ip (iproute2) for IPv6 (-6) scanning
#   - nft (nftables) and sudo for host blocking (-K/-U/-L)
#   - Standard Unix tools: grep, sort, cut, head, xargs, awk, sed, getent, tput, realpath
#
# Author: OKUSI Project
# Version: 2.0.0
# License: GPL-3.0
# Guard before any version-dependent feature (inherit_errexit needs Bash 4.4+).
if ((BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 2))); then
  >&2 echo "${0##*/}: requires Bash >= 5.2 (have ${BASH_VERSION:-unknown})"
  exit 2
fi
set -euo pipefail
shopt -s inherit_errexit

declare -r VERSION=2.0.0
#shellcheck disable=SC2155
declare -r SCRIPT_PATH=$(realpath -- "$0")
#shellcheck disable=SC2034  # BCS0104: standard metadata
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*}
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

declare -- CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}"/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf

# Default configuration variables
# Overridden by system config (/etc/lhssh/lhssh.conf or /etc/lhssh.conf) then
# user config (see load_config)
declare -- LOCALHOST_HEAD='192.168.1.'      # Network prefix (must end with dot)
declare -i LOCALHOST_START_IP=50            # First IP in scan range (last octet)
declare -i LOCALHOST_END_IP=230             # Last IP in scan range (last octet)
declare -- LOGIN_USERNAME=${USER:-root}     # SSH login username
declare -i SHORT_DISPLAY=0                  # Show IP addresses only (no hostnames)
declare -i SUPER_SHORT=0                    # Show last octet only
declare -i SHOW_HOSTNAME=0                  # Append hostname to short/supershort output
declare -i SSH_CONNECT_TIMEOUT=10           # SSH connection timeout (seconds)
declare -i SSH_SESSION_TIMEOUT=600          # SSH session timeout (seconds)
declare -i VERBOSE=0                        # Verbosity level (0=normal, 1=info, 2=debug)
declare -i COLOR_OUTPUT=1                   # Enable colored output (0=disable)
declare -i PARALLEL_SCAN=1                  # Use parallel scanning (0=sequential)
declare -i IPV6_SCAN=0                      # Scan IPv6 instead of IPv4
declare -- IPV6_INTERFACE=''                # IPv6 interface (empty=auto-detect)
declare -i SUPPRESS_EXIT_LOG=0              # Skip cleanup error log once ssh takes over

# Color codes (readonly; --no-color controls output via COLOR_OUTPUT flag)
if [[ -t 1 && -t 2 ]] && [[ -z "${NO_COLOR:-}" ]] && tput colors &>/dev/null; then
  declare -r RED=$'\033[0;31m' YELLOW=$'\033[0;33m' BLUE=$'\033[0;34m' NC=$'\033[0m'
else
  declare -r RED='' YELLOW='' BLUE='' NC=''
  COLOR_OUTPUT=0
fi

# Validate that an option's required argument is present
# Usage: require_arg "$@" (call before shift in option parsing)
require_arg() { (($# > 1)) || { log_error "Option ${1@Q} requires an argument"; return 8; }; }

# Validate $1 is an integer within [min,max]. Usage: require_int VALUE MIN MAX FLAG
# Returns 9 (value out of range) on failure. Use 10# at the call site to coerce.
require_int() {
  local -- val=$1 flag=$4
  local -i min=$2 max=$3
  [[ "$val" =~ ^[0-9]+$ ]] || { log_error "Option $flag expects a number, got ${val@Q}"; return 9; }
  ((10#$val >= min && 10#$val <= max)) || { log_error "Option $flag out of range [$min-$max]: ${val@Q}"; return 9; }
}

log() {
  local -- level=$1
  shift
  local -- message="$*"
  # Use local copies so --no-color works with readonly color vars
  local -- r='' y='' b='' n=''
  if ((COLOR_OUTPUT)); then
    r=$RED y=$YELLOW b=$BLUE n=$NC
  fi

  case "$level" in
    ERROR)
      >&2 echo -e "${r}[ERROR]${n} $message"
      ;;
    WARN)
      ((VERBOSE >= 0)) || return 0
      >&2 echo -e "${y}[WARN]${n} $message"
      ;;
    INFO)
      ((VERBOSE >= 1)) || return 0
      >&2 echo -e "${b}[INFO]${n} $message"
      ;;
    DEBUG)
      ((VERBOSE >= 2)) || return 0
      >&2 echo -e "[DEBUG] $message"
      ;;
    *)
      echo "$message"
      ;;
  esac
}

# Convenience logging functions
log_error() { log ERROR "$@"; }
log_warn() { log WARN "$@"; }
log_info() { log INFO "$@"; }
log_debug() { log DEBUG "$@"; }

error_msg() {
  local -i exit_code=$1
  case $exit_code in
    0)   echo 'Success' ;;
    1)   echo 'General error' ;;
    2)   echo 'Usage error' ;;
    3)   echo 'No such file or directory' ;;
    8)   echo 'Required argument missing' ;;
    9)   echo 'Value out of range' ;;
    22)  echo 'Invalid argument' ;;
    23)  echo 'Network error' ;;
    24)  echo 'Operation timed out' ;;
    25)  echo 'Host unreachable' ;;
    124) echo 'Operation timed out' ;;
    137) echo 'Killed after timeout' ;;
    126) echo 'Command cannot execute' ;;
    127) echo 'Command not found' ;;
    130) echo 'Interrupted by Ctrl+C' ;;
    255) echo 'SSH connection failed' ;;
    *)   echo "Unknown error (code: $exit_code)" ;;
  esac
}

cleanup() {
  trap - SIGINT SIGTERM EXIT
  local -i exit_code=${1:-$?}
  # Don't log when SSH failed (255) or when control already passed to ssh —
  # in connect mode the exit code belongs to the remote command, not lhssh.
  if ((exit_code != 0 && exit_code != 255 && !SUPPRESS_EXIT_LOG)); then
    log_error "Exit: $(error_msg "$exit_code")"
  fi
  exit "$exit_code"
}

trap 'cleanup $?' SIGINT SIGTERM EXIT

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Local Host SSH Scanner and Connection Manager

USAGE:
  $SCRIPT_NAME [OPTIONS] [TARGET [COMMAND...]]

DESCRIPTION:
  Scan local network for SSH hosts and connect to them easily.
  TARGET can be a short octet (152), full IPv4 (192.168.1.152), or IPv6 address.

OPTIONS:
  -h, --help              Show this help message
  -V, --version           Show version information
  -v, --verbose           Enable verbose output (use -vv for debug)
  -q, --quiet             Disable all non-essential output

  Display Options:
  -s, --short             Show IP addresses only
  -p, --supershort        Show only last octet (IPv4); full address (IPv6)
  -H, --with-hostname     Add hostname to -s/-p output (tab-separated)
  -C, --no-color          Disable colored output

  Network Options:
  -n, --network PREFIX    Set network prefix or CIDR /24 (default: $LOCALHOST_HEAD)
  -b, --begin IP          Start IP for scanning (default: $LOCALHOST_START_IP)
  -f, --finish IP         End IP for scanning (default: $LOCALHOST_END_IP)
  -6, --ipv6              Scan IPv6 link-local neighbors instead of IPv4
  -I, --interface IFACE   Network interface for IPv6 scanning (default: auto)

  SSH Options:
  -u, --user USERNAME     SSH username (default: $LOGIN_USERNAME)
  -t, --timeout SECS      Connection timeout (default: $SSH_CONNECT_TIMEOUT)
  -T, --session-time SECS Session timeout (default: $SSH_SESSION_TIMEOUT)

  Host Blocking (temporary — cleared on reboot):
  -K, --kill IP           Block an IP address via nft (requires sudo)
  -U, --unkill IP         Unblock a previously blocked IP address
  -L, --list-killed       Show currently blocked IP addresses

  Configuration:
  -l, --list              Show current configuration
  -e, --edit              Edit configuration file
  -S, --save-config       Save current options to configuration file

EXAMPLES:
  # Scan network for SSH hosts
  $SCRIPT_NAME

  # Connect to host .152
  $SCRIPT_NAME 152

  # Run command on host
  $SCRIPT_NAME 152 uptime

  # Scan different network range
  $SCRIPT_NAME -n 10.0.0. -b 1 -f 50

  # Scan CIDR /24 network
  $SCRIPT_NAME -n 10.99.10.0/24

  # Scan IPv6 neighbors for SSH hosts
  $SCRIPT_NAME -6

  # Scan IPv6 on a specific interface
  $SCRIPT_NAME -6 -I eth0

  # Connect to an IPv6 host
  $SCRIPT_NAME fe80::1%enp12s0 hostname

  # Execute command on all hosts
  for ip in \$($SCRIPT_NAME -p); do
    $SCRIPT_NAME \$ip "hostname -f"
  done

CONFIGURATION FILE:
  $CONFIG_FILE
HELP
}

create_config_file() {
  mkdir -p "${CONFIG_FILE%/*}"
  cat > "$CONFIG_FILE" <<CONFIG
#!/bin/bash
# $SCRIPT_NAME: Display ssh accessible localhosts / Run commands on localhosts
# [IPv4] localhost header (e.g. 192.168.1.); omit last number; end with dot
LOCALHOST_HEAD=$LOCALHOST_HEAD
# [IPv4] start scanning from this IP
LOCALHOST_START_IP=$LOCALHOST_START_IP
# [IPv4] stop scanning at this IP
LOCALHOST_END_IP=$LOCALHOST_END_IP
# [shared] ssh login username
LOGIN_USERNAME=$LOGIN_USERNAME
# [shared] short display of IPs only
SHORT_DISPLAY=$SHORT_DISPLAY
# [shared] supershort display (last octet for IPv4; full address for IPv6)
SUPER_SHORT=$SUPER_SHORT
# [shared] connection timeout in seconds (also controls IPv6 ping timeout)
SSH_CONNECT_TIMEOUT=$SSH_CONNECT_TIMEOUT
# [shared] ssh session timeout in seconds
SSH_SESSION_TIMEOUT=$SSH_SESSION_TIMEOUT
# [shared] enable colored output
COLOR_OUTPUT=$COLOR_OUTPUT
# [IPv4] use parallel scanning (faster)
PARALLEL_SCAN=$PARALLEL_SCAN
# [IPv6] network interface for scanning (empty=auto-detect from default route)
IPV6_INTERFACE='$IPV6_INTERFACE'
#fin
CONFIG
  chmod 600 "$CONFIG_FILE"
  log_info "Created configuration file ${CONFIG_FILE@Q}"
}

# Whitelisted config keys. Integer keys accept only numeric values; string keys
# are assigned literally. Anything else in a config file is ignored.
declare -ra CONFIG_INT_KEYS=(
  LOCALHOST_START_IP LOCALHOST_END_IP SHORT_DISPLAY SUPER_SHORT SHOW_HOSTNAME
  SSH_CONNECT_TIMEOUT SSH_SESSION_TIMEOUT COLOR_OUTPUT PARALLEL_SCAN
)
declare -ra CONFIG_STR_KEYS=(LOCALHOST_HEAD LOGIN_USERNAME IPV6_INTERFACE)

# Read KEY=VALUE pairs from a config file into whitelisted globals.
# The file is parsed, never sourced, so a config file can NEVER execute code —
# this closes the arbitrary-execution hole of sourcing attacker-plantable files.
parse_config_file() {
  local -- file=$1
  local -- line key value k
  local -i lineno=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno+=1
    # Trim surrounding whitespace
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    # Skip blanks, comments, shebang, #fin
    [[ -z "$line" || "$line" == '#'* || "$line" == '!'* ]] && continue
    if [[ "$line" != *=* ]]; then
      log_warn "Ignoring malformed config line $lineno in ${file@Q}"
      continue
    fi
    key=${line%%=*}; key=${key//[[:space:]]/}
    value=${line#*=}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    # Strip one layer of surrounding matching quotes
    if ((${#value} >= 2)) && { [[ "$value" == \"*\" ]] || [[ "$value" == \'*\' ]]; }; then
      value=${value:1:-1}
    fi
    # Integer key: accept only a pure integer (blocks any arithmetic/command eval)
    for k in "${CONFIG_INT_KEYS[@]}"; do
      if [[ "$key" == "$k" ]]; then
        if [[ "$value" =~ ^-?[0-9]+$ ]]; then
          printf -v "$key" '%s' "$value"
        else
          log_warn "Ignoring non-numeric value for $key in ${file@Q}: ${value@Q}"
        fi
        continue 2
      fi
    done
    # String key: assign literally, no evaluation
    for k in "${CONFIG_STR_KEYS[@]}"; do
      if [[ "$key" == "$k" ]]; then
        printf -v "$key" '%s' "$value"
        continue 2
      fi
    done
    log_warn "Ignoring unknown config key ${key@Q} in ${file@Q}"
  done < "$file"
}

load_config() {
  # System-wide defaults first (parsed, not sourced). Only root-managed /etc.
  if [[ -f /etc/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf ]]; then
    parse_config_file /etc/"$SCRIPT_NAME"/"$SCRIPT_NAME".conf
  elif [[ -f /etc/"$SCRIPT_NAME".conf ]]; then
    parse_config_file /etc/"$SCRIPT_NAME".conf
  fi

  # User config overrides (first found wins). ONLY user-owned $HOME locations are
  # searched. Package/data dirs (/usr/local/etc, /usr/share, /usr/lib) are
  # deliberately excluded: they may be writable by non-root accounts and were a
  # code-execution vector when configs were sourced.
  local -- conf_file
  local -a search_paths=(
    "$HOME/.$SCRIPT_NAME.conf"                                          # legacy
    "${XDG_CONFIG_HOME:-$HOME/.config}/$SCRIPT_NAME/$SCRIPT_NAME.conf"  # XDG
  )
  for conf_file in "${search_paths[@]}"; do
    if [[ -f "$conf_file" ]]; then
      parse_config_file "$conf_file"
      CONFIG_FILE=$conf_file
      return 0
    fi
  done

  # No config file found — fall back to built-in defaults. CONFIG_FILE keeps its
  # XDG default so -S/-e and the lazy creation in main() target it. We do NOT
  # create a file here, so read-only commands (--help/--version/-l/-L) have no
  # filesystem side effect.
  return 0
}

# Generate IP list for a scan range to stdout
# Args: start_ip end_ip (last octets only)
generate_ip_list() {
  local -i ip
  for ((ip=$1; ip<=$2; ip+=1)); do
    printf '%s\n' "${LOCALHOST_HEAD}${ip}"
  done
}

detect_ipv6_interface() {
  local -- iface
  iface=$(ip -6 route show default 2>/dev/null | awk '{print $5}' | head -1)
  if [[ -z "$iface" ]]; then
    log_error 'No IPv6 default route found; specify interface with -I'
    return 1
  fi
  printf '%s\n' "$iface"
}

# Discover IPv6 neighbors via all-nodes multicast ping
discover_ipv6_neighbors() {
  local -- iface=$1
  # ping6 -W is the response-wait timeout in SECONDS. The old code passed
  # milliseconds (SSH_CONNECT_TIMEOUT * 1000), 1000x too large, which hung the
  # scan for hours on a quiet/empty IPv6 link.
  # Prefer ping6; fall back to `ping -6` on systems that dropped the alias.
  local -a ping_cmd=(ping6)
  command -v ping6 &>/dev/null || ping_cmd=(ping -6)
  "${ping_cmd[@]}" -c 2 -W "$SSH_CONNECT_TIMEOUT" "ff02::1%${iface}" 2>/dev/null \
    | awk '/from /{print $4}' \
    | sed 's/:$//' \
    | sort -u
}

scan_ipv6_hosts() {
  local -- iface=${IPV6_INTERFACE:-}
  if [[ -z "$iface" ]]; then
    iface=$(detect_ipv6_interface) || return 1
  fi

  log_info "Scanning IPv6 hosts on interface ${iface}"

  discover_ipv6_neighbors "$iface" \
    | ssh-keyscan -T 1 -t ed25519 -f - 2>/dev/null \
    | awk '{print $1}' \
    | sort -u
}

scan_ssh_hosts_keyscan() {
  local -- start_ip=$1 end_ip=$2

  log_info "Scanning hosts ${LOCALHOST_HEAD}${start_ip}-${end_ip} using ssh-keyscan"

  # ssh-keyscan handles concurrency natively via -f -; single key type suffices for detection
  if ((PARALLEL_SCAN)); then
    generate_ip_list "$start_ip" "$end_ip" | \
      ssh-keyscan -T 1 -t ed25519 -f - 2>/dev/null | awk '{print $1}' | sort -u
  else
    local -- host
    while IFS= read -r host; do
      if ssh-keyscan -T 1 -t ed25519 "$host" 2>/dev/null | grep -q "^$host "; then
        echo "$host"
      fi
    done < <(generate_ip_list "$start_ip" "$end_ip")
  fi
}

scan_ssh_hosts_nc() {
  local -- start_ip=$1 end_ip=$2

  log_info "Scanning hosts ${LOCALHOST_HEAD}${start_ip}-${end_ip} using netcat"

  if ((PARALLEL_SCAN)); then
    #shellcheck disable=SC2016  # $1 expands inside inner sh, not outer bash
    generate_ip_list "$start_ip" "$end_ip" | \
      xargs -P 20 -I {} sh -c 'nc -z -w1 "$1" 22 2>/dev/null && echo "$1"' _ {}
  else
    local -- host
    while IFS= read -r host; do
      if nc -z -w1 "$host" 22 2>/dev/null; then
        echo "$host"
      fi
    done < <(generate_ip_list "$start_ip" "$end_ip")
  fi
}

#shellcheck disable=SC2120
scan_hosts() {
  if ((IPV6_SCAN)); then
    scan_ipv6_hosts
    return
  fi

  local -- start_ip=${1:-$LOCALHOST_START_IP}
  local -- end_ip=${2:-$LOCALHOST_END_IP}

  if command -v ssh-keyscan &>/dev/null; then
    scan_ssh_hosts_keyscan "$start_ip" "$end_ip"
  elif command -v nc &>/dev/null; then
    scan_ssh_hosts_nc "$start_ip" "$end_ip"
  else
    log_error 'No suitable scanning tool found (ssh-keyscan or nc required)'
    return 1
  fi
}

format_output() {
  # Family is derived from the whole set, not just $1, so a mixed/misordered
  # list is not mis-formatted by guessing from the first element.
  local -i has_ipv6=0
  local -- a
  for a in "$@"; do
    [[ "$a" == *:* ]] && { has_ipv6=1; break; }
  done

  local -a hosts
  if ((has_ipv6)); then
    readarray -t hosts < <(printf '%s\n' "$@" | sort)
  else
    # Sort by the LAST dotted field numerically. Works for any prefix length
    # (e.g. 10.0. -> 3-field addresses), unlike a hardcoded `-k4`.
    readarray -t hosts < <(printf '%s\n' "$@" | awk -F. '{print $NF"\t"$0}' | sort -n | cut -f2-)
  fi
  local -- host

  if ((SUPER_SHORT || SHORT_DISPLAY)); then
    # BCS0503: declare loop-body locals once, outside the for loop
    local -- label hn
    for host in "${hosts[@]}"; do
      # Truncate to last octet only for IPv4 entries (decided per element)
      if ((SUPER_SHORT)) && [[ "$host" != *:* ]]; then
        label="${host##*.}"
      else
        label="$host"
      fi
      if ((SHOW_HOSTNAME)); then
        hn=$(getent hosts "$host" 2>/dev/null | awk '{print $2}' ||:)
        printf '%s\t%s\n' "$label" "$hn"
      else
        echo "$label"
      fi
    done
  else
    if ((VERBOSE >= 0)); then >&2 echo 'SSH Hosts Found:'; fi
    local -- hostname col_width=15
    # BCS0606: terminate the arithmetic && chain so a false test can't leak rc=1
    ((has_ipv6)) && col_width=45 ||:
    for host in "${hosts[@]}"; do
      hostname=$(getent hosts "$host" 2>/dev/null | awk '{print $2}' || echo "")
      if [[ -n "$hostname" ]]; then
        printf "%-${col_width}s %s\n" "$host" "$hostname"
      else
        echo "$host"
      fi
    done
  fi
}

declare -r NFT_TABLE='lhssh'
declare -r NFT_CHAIN='blocked'

# Validate an IP address (IPv4 dotted or IPv6 with optional zone ID)
validate_ip() {
  local -- ip=$1
  if [[ "$ip" =~ : ]]; then
    [[ "$ip" =~ ^[a-fA-F0-9:.]+(%[a-zA-Z0-9._-]+)?$ ]] || {
      log_error "Invalid IPv6 address ${ip@Q}"; return 22
    }
  elif [[ "$ip" =~ ^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$ ]]; then
    : # bounded 0-255 per octet, leading zeros rejected
  else
    log_error "Invalid IP address ${ip@Q} (use full IP, not short octet)"
    return 22
  fi
}

# Ensure the lhssh nft table and chain exist
nft_ensure_chain() {
  sudo nft list table inet "$NFT_TABLE" &>/dev/null && return 0
  log_info "Creating nft table inet ${NFT_TABLE}"
  sudo nft add table inet "$NFT_TABLE" || { log_error 'Failed to create nft table (need sudo?)'; return 1; }
  # hook input: a drop rule must see traffic destined to THIS host. The forward
  # hook only sees routed/forwarded traffic, which a non-gateway box never has,
  # so a forward-chain block would silently do nothing.
  sudo nft add chain inet "$NFT_TABLE" "$NFT_CHAIN" '{ type filter hook input priority 0; policy accept; }'
}

# Block an IP via nft (temporary — cleared on reboot)
kill_host() {
  local -- ip=$1
  validate_ip "$ip" || return $?
  nft_ensure_chain || return $?

  # Select the nft match family by address type; strip any %zone suffix, which
  # nft does not accept in an saddr match.
  local -- proto=ip match=$ip
  if [[ "$ip" == *:* ]]; then
    proto=ip6
    match=${ip%%\%*}
  fi

  # Check if already blocked
  if sudo nft list chain inet "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null | grep -q "saddr $match "; then
    log_warn "Host ${ip} is already blocked"
    return 0
  fi

  if sudo nft add rule inet "$NFT_TABLE" "$NFT_CHAIN" "$proto" saddr "$match" drop; then
    log_info "Blocked ${ip} (temporary — cleared on reboot)"
  else
    log_error "Failed to block ${ip}"; return 1
  fi
}

# Unblock an IP
unkill_host() {
  local -- ip=$1
  validate_ip "$ip" || return $?

  if ! sudo nft list table inet "$NFT_TABLE" &>/dev/null; then
    log_warn "No blocked hosts (nft table ${NFT_TABLE} does not exist)"
    return 0
  fi

  # Strip any %zone suffix to match the stored rule
  local -- match=$ip
  [[ "$ip" == *:* ]] && match=${ip%%\%*}

  # Find and delete the matching rule handle
  local -- handle
  handle=$(sudo nft -a list chain inet "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null \
    | grep "saddr $match " | awk '{print $NF}')

  if [[ -z "$handle" ]]; then
    log_warn "Host ${ip} is not blocked"
    return 0
  fi

  if sudo nft delete rule inet "$NFT_TABLE" "$NFT_CHAIN" handle "$handle"; then
    log_info "Unblocked ${ip}"
  else
    log_error "Failed to unblock ${ip}"; return 1
  fi
}

# List currently blocked IPs
list_killed() {
  if ! sudo nft list table inet "$NFT_TABLE" &>/dev/null; then
    echo 'No blocked hosts'
    return 0
  fi

  local -a blocked=()
  readarray -t blocked < <(sudo nft list chain inet "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null \
    | grep 'saddr .* drop' | awk '{for(i=1;i<=NF;i++) if($i=="saddr") print $(i+1)}')

  if ((${#blocked[@]} == 0)); then
    echo 'No blocked hosts'
  else
    echo 'Blocked hosts (temporary — cleared on reboot):'
    printf '  %s\n' "${blocked[@]}"
  fi
}

ssh_connect() {
  local -- target=$1
  shift
  local -a ssh_args=("$@")

  # TARGET is one of: IPv6 (has colon), full dotted IPv4 (has dot), or a short
  # octet (expanded via LOCALHOST_HEAD). Each form is validated — a dotted
  # target is NOT passed through unchecked.
  local -- oct='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
  if [[ "$target" =~ : ]]; then
    if [[ ! "$target" =~ ^[a-fA-F0-9:.]+(%[a-zA-Z0-9._-]+)?$ ]]; then
      log_error "Invalid IPv6 address ${target@Q}"
      return 22
    fi
  elif [[ "$target" =~ \. ]]; then
    # Full dotted IPv4 — validate four bounded octets (docs: TARGET is IPv4/IPv6/octet)
    if [[ ! "$target" =~ ^${oct}(\.${oct}){3}$ ]]; then
      log_error "Invalid IPv4 address ${target@Q}"
      return 22
    fi
  else
    # Short octet. 10# forces base-10 so leading-zero octets (08/09) don't abort as bad octal
    if [[ ! "$target" =~ ^[0-9]+$ ]] || ((10#$target < 1 || 10#$target > 254)); then
      log_error "Invalid IP octet ${target@Q} (must be 1-254)"
      return 22
    fi
    target="${LOCALHOST_HEAD}$((10#$target))"
  fi

  local -a ssh_opts=(
    -o "ConnectTimeout=${SSH_CONNECT_TIMEOUT}"
    -o 'PasswordAuthentication=no'
    -o 'StrictHostKeyChecking=accept-new'
  )

  # Map verbosity to ssh -v levels. Quiet (VERBOSE=-1) and normal (0) add none;
  # the old `((VERBOSE==0)) || -v` wrongly made --quiet pass ssh -v.
  if ((VERBOSE >= 2)); then
    ssh_opts+=(-v -v)
  elif ((VERBOSE == 1)); then
    ssh_opts+=(-v)
  fi

  log_info "Connecting to ${LOGIN_USERNAME}@${target}"

  # From here the exit status belongs to ssh / the remote command, not lhssh —
  # stop the cleanup trap from relabelling it as an lhssh error (GAP: e.g.
  # `lhssh 152 'grep foo x'` returning 1 must not print "[ERROR] General error").
  SUPPRESS_EXIT_LOG=1

  if ((${#ssh_args[@]})); then
    # Execute command with timeout protection
    # --kill-after=10: Force kill if still running 10s after timeout
    timeout --kill-after=10 "$SSH_SESSION_TIMEOUT" \
      ssh "${ssh_opts[@]}" "${LOGIN_USERNAME}"@"${target}" "${ssh_args[@]}"
  else
    # Interactive session (no timeout for user interaction)
    ssh "${ssh_opts[@]}" "${LOGIN_USERNAME}"@"${target}"
  fi
}

main() {
  local -a args=()
  local -a ssh_command=()
  local -- action=scan
  # BCS0503: hoisted out of the -n case below (declared once, not per loop pass).
  # oct is the bounded 0-255 octet pattern reused for network-prefix validation.
  local -- net oct='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'

  # Load configuration first
  load_config

  # Parse command line arguments
  while (($#)); do
    case $1 in
      -h|--help)
        show_help
        return 0
        ;;
      -V|--version)
        echo "$SCRIPT_NAME $VERSION"
        return 0
        ;;
      -v|--verbose)
        VERBOSE+=1
        ;;
      -q|--quiet)
        VERBOSE=-1
        ;;
      -s|--short)
        SHORT_DISPLAY=1
        ;;
      -p|--supershort)
        SHORT_DISPLAY=1
        SUPER_SHORT=1
        ;;
      -H|--with-hostname)
        SHOW_HOSTNAME=1
        ;;
      -C|--no-color)
        COLOR_OUTPUT=0
        ;;
      -n|--network)
        require_arg "$@"; shift
        net=$1
        if [[ "$net" == */* ]]; then
          # CIDR: only /24 maps onto last-octet scanning; reject other masks loudly
          if [[ ! "$net" =~ ^${oct}(\.${oct}){3}/24$ ]]; then
            log_error "Only /24 CIDR is supported for -n: ${net@Q}"
            return 22
          fi
          net=${net%/24}
          LOCALHOST_HEAD="${net%.*}."   # drop host octet -> 3-octet prefix + dot
          LOCALHOST_START_IP=1
          LOCALHOST_END_IP=254
        else
          net=${net%.}                  # tolerate a trailing dot
          # Must be 1-3 bounded dotted-decimal octets (a prefix), not arbitrary text
          if [[ ! "$net" =~ ^${oct}(\.${oct}){0,2}$ ]]; then
            log_error "Invalid network prefix ${1@Q} (e.g. 192.168.1. or 10.0.0.0/24)"
            return 22
          fi
          LOCALHOST_HEAD="${net}."
        fi
        ;;
      -b|--begin)
        require_arg "$@"; shift
        require_int "$1" 0 255 -b || return $?
        LOCALHOST_START_IP=$((10#$1))
        ;;
      -f|--finish)
        require_arg "$@"; shift
        require_int "$1" 0 255 -f || return $?
        LOCALHOST_END_IP=$((10#$1))
        ;;
      -u|--user)
        require_arg "$@"; shift
        LOGIN_USERNAME=$1
        ;;
      -t|--timeout)
        require_arg "$@"; shift
        require_int "$1" 1 86400 -t || return $?
        SSH_CONNECT_TIMEOUT=$((10#$1))
        ;;
      -T|--session-time)
        require_arg "$@"; shift
        require_int "$1" 1 86400 -T || return $?
        SSH_SESSION_TIMEOUT=$((10#$1))
        ;;
      -l|--list)
        grep -v '^#!' "$CONFIG_FILE" 2>/dev/null ||:
        return 0
        ;;
      -e|--edit)
        [[ -f "$CONFIG_FILE" ]] || create_config_file
        "${EDITOR:-nano}" "$CONFIG_FILE"
        return 0
        ;;
      -K|--kill)
        require_arg "$@"; shift
        kill_host "$1"
        return $?
        ;;
      -U|--unkill)
        require_arg "$@"; shift
        unkill_host "$1"
        return $?
        ;;
      -L|--list-killed)
        list_killed
        return 0
        ;;
      -6|--ipv6)
        IPV6_SCAN=1
        ;;
      -I|--interface)
        require_arg "$@"; shift
        IPV6_INTERFACE=$1
        IPV6_SCAN=1
        ;;
      -S|--save-config)
        create_config_file
        return 0
        ;;
      --)
        # Stop option parsing. Remaining tokens are positional: first is the
        # target, rest are the ssh command (resolved in the dispatch block).
        shift
        args+=("$@")
        break
        ;;

      # Handle combined short options (e.g., -vp becomes -v -p).
      # Boolean flags ONLY — argument-taking flags (-n -b -f -u -t -T -I -K -U)
      # are excluded so attached values like -n10.0.0. are not silently mangled.
      -[hVvqspHCleSL6]?*) set -- "${1:0:2}" "-${1:2}" "${@:2}"
        continue
        ;;

      -*)
        log_error "Unknown option ${1@Q}"
        >&2 show_help
        return 22
        ;;
      *)
        args+=("$1")
        ;;
    esac
    shift
  done

  # Determine action based on arguments
  if ((${#args[@]})); then
    # SSH connection mode: first arg is target, rest are SSH command
    action=connect
    local -- target="${args[0]}"
    ssh_command+=("${args[@]:1}")
  fi

  # Create the default config on first real use (scan/connect) — not on the
  # read-only commands above, which return before reaching here.
  [[ -f "$CONFIG_FILE" ]] || create_config_file

  case "$action" in
    scan)
      # Verify a scan tool exists BEFORE scanning. Otherwise scan_hosts' failure
      # is swallowed by the process substitution below and misreported as
      # "no hosts found" rather than the real "tool missing" cause.
      if ((IPV6_SCAN)); then
        if ! command -v ip &>/dev/null \
          || { ! command -v ping6 &>/dev/null && ! command -v ping &>/dev/null; }; then
          log_error 'IPv6 scan requires ip (iproute2) and ping6 or ping'
          return 23
        fi
      elif ! command -v ssh-keyscan &>/dev/null && ! command -v nc &>/dev/null; then
        log_error 'No suitable scanning tool found (ssh-keyscan or nc required)'
        return 23
      fi

      # Scan network for SSH hosts
      local -a hosts
      readarray -t hosts < <(scan_hosts)  # Read scan results into array

      log_debug "Found ${#hosts[@]} hosts"

      if ((${#hosts[@]} == 0)); then
        if ((IPV6_SCAN)); then
          local -- warn_iface=${IPV6_INTERFACE:-$(detect_ipv6_interface 2>/dev/null || echo 'unknown')}
          log_warn "No SSH hosts found via IPv6 on ${warn_iface}"
        else
          log_warn "No SSH hosts found in range ${LOCALHOST_HEAD}${LOCALHOST_START_IP}-${LOCALHOST_END_IP}"
        fi
        return 0
      fi

      format_output "${hosts[@]}"
      ;;

    connect)
      ssh_connect "$target" "${ssh_command[@]}"
      ;;

    *)
      log_error "Unknown action ${action@Q}"
      return 1
      ;;
  esac
}

# Script entry point - pass all arguments to main
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
#fin
